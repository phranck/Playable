# Generated from the configuration inventory in packages/config.
# Editing this file has no effect: the next run overwrites it.
# Change packages/config/src/inventory.ts and run pnpm generate.

# What libraries assume about optimization, caching and error detail.
# Read by: backend, website, dashboard, worker
# One of: development, test, production
# Optional, defaults to development.
NODE_ENV=development

# Which deployment this is, which decides what data and credentials it may reach.
# Read by: backend, website, dashboard, worker
# One of: local, preview, staging, production
# Optional, defaults to local.
PLAYABLE_ENVIRONMENT=local

# The address to bind to. Deployments bind dual-stack, so the value there is a bare colon pair.
# Read by: backend, website
# Optional, defaults to 127.0.0.1.
HOST=127.0.0.1

# The port to listen on.
# Read by: backend, website
# Optional, defaults to 4000.
PORT=4000

# The runtime and ordinary migration connection, owned by the unprivileged application role.
# Read by: backend, worker
# Required.
DATABASE_URL=postgresql://playable:dev-password-local-only@127.0.0.1:5435/playable

# The exact role migrations must run as. The runner aborts when the connected role differs.
# Read by: backend, worker
# Required.
DB_MIGRATION_ROLE=playable

# Where the website reaches the backend. Inside a deployment this is the internal service address.
# Read by: website
# Required.
BACKEND_URL=http://127.0.0.1:4000

# The legacy Parse REST address the live overview reads channels from, until Playable's own API exists.
# Read by: website
# Required.
PARSE_SERVER_URL=https://parse.example.com/parse

# Identifies this application to the legacy Parse backend.
# Read by: website
# Required.
PARSE_APPLICATION_ID=replace-with-the-application-id

# Reads channels from the legacy Parse backend. Never the master key: this site only reads.
# Read by: website
# Required.
PARSE_REST_API_KEY=replace-with-the-rest-api-key

# Comma-separated origins the backend accepts browser requests from.
# Read by: backend
# Optional, defaults to http://127.0.0.1:3000.
ALLOWED_ORIGINS=http://127.0.0.1:3000
