---
import type { LiveChannel } from "@playable/contracts";
import StateBadge from "./StateBadge.astro";

interface Props {
  /** The channel this card stands for. */
  channel: LiveChannel;
}

const { channel } = Astro.props;
---

<a class="card" href={`/live/${channel.id}`} data-on-air={channel.onAir}>
  <div class="cover">
    {
      channel.coverUrl ? (
        <img src={channel.coverUrl} alt="" loading="lazy" decoding="async" width="88" height="88" />
      ) : (
        <span class="placeholder" aria-hidden="true">
          {channel.name.slice(0, 1)}
        </span>
      )
    }
  </div>

  <div class="body">
    <h2 class="name">{channel.name}</h2>
    {channel.description && <p class="description">{channel.description}</p>}
    <StateBadge channel={channel} />
  </div>
</a>

<style>
  .card {
    display: flex;
    gap: var(--space-4);
    /* Equal on all four sides. The optical difference a split padding reaches
       for is what the text inset already provides. */
    padding: var(--card-padding);
    border: 1px solid var(--edge);
    border-radius: var(--card-radius);
    background: var(--surface-card);
    color: inherit;
    text-decoration: none;
    transition:
      border-color var(--motion-quick) var(--motion-ease),
      background-color var(--motion-quick) var(--motion-ease),
      transform var(--motion-quick) var(--motion-ease);
  }

  .card:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    background: var(--surface-raised);
    transform: translateY(-2px);
  }

  .card[data-on-air="true"] {
    border-color: color-mix(in srgb, var(--state-on-air) 35%, transparent);
  }

  .cover {
    flex: none;
    inline-size: 88px;
    block-size: 88px;
    /* Nested inside the card, so the outer radius less the distance to it. */
    border-radius: var(--card-inner-radius);
    overflow: hidden;
    background: var(--surface-raised);
    display: grid;
    place-items: center;
  }

  .cover img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .placeholder {
    font-size: var(--size-display);
    font-weight: 600;
    color: var(--text-muted);
  }

  .body {
    /* Without this a long description refuses to shorten and widens the card. */
    min-inline-size: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: flex-start;
  }

  .name {
    margin: 0;
    font-size: var(--size-heading);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .description {
    margin: 0;
    color: var(--text-secondary);
    font-size: var(--size-small);
    /* Two lines, then it stops. A card in a grid that grows with its text
       makes every other card in its row grow with it. */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
