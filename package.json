{
  "name": "playable",
  "private": true,
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=22.23.1"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/**\" build && pnpm -r --if-present build",
    "check:config": "pnpm --filter @playable/config build && node scripts/sync-config-files.mjs --check",
    "check:desktop-modules": "node scripts/check-shared-swift-modules.mjs",
    "check:documentation": "pnpm --filter @playable/docs build && node scripts/check-documentation.mjs",
    "check:workspaces": "node scripts/check-workspace-boundaries.mjs",
    "config:sync": "pnpm --filter @playable/config build && node scripts/sync-config-files.mjs",
    "desktop:build": "swift build --package-path apps/desktop",
    "desktop:test": "swift test --package-path apps/desktop",
    "format": "biome format --write apps packages scripts",
    "lint": "biome check apps packages scripts",
    "lint:fix": "biome check --write apps packages scripts",
    "test": "pnpm --filter \"./packages/**\" build && pnpm -r --if-present test",
    "typecheck": "pnpm --filter \"./packages/**\" build && pnpm -r --if-present typecheck",
    "verify": "pnpm check:workspaces && pnpm check:desktop-modules && pnpm check:documentation && pnpm check:config && pnpm lint && pnpm typecheck && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@playable/config": "workspace:*",
    "@playable/docs": "workspace:*",
    "typescript": "^5.9.3"
  }
}
